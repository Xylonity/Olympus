{
  "multipart": [
    { "apply": { "model": "olympus:block/climbing_rose" }, "when": { "north": "true" } },
    { "apply": { "model": "olympus:block/climbing_rose", "uvlock": true, "y": 90 }, "when": { "east": "true" } },
    { "apply": { "model": "olympus:block/climbing_rose", "uvlock": true, "y": 180 }, "when": { "south": "true" } },
    { "apply": { "model": "olympus:block/climbing_rose", "uvlock": true, "y": 270 }, "when": { "west": "true" } },
    { "apply": { "model": "olympus:block/climbing_rose", "uvlock": true, "x": 270 }, "when": { "up": "true" } },
    { "apply": { "model": "olympus:block/climbing_rose", "uvlock": true, "x": 90 }, "when": { "down": "true" } }
  ]
}
